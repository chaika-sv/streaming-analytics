<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ru.chaika.streaming</groupId>
        <artifactId>streaming-analytics</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-job</artifactId>

    <dependencies>
        <dependency>
            <groupId>ru.chaika.streaming</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
            <exclusions>
                <!-- Тот же конфликт slf4j-api, что чинили в web-producer/spring-consumer.
                     Flink тоже приносит свою версию логирования, поэтому исключаем
                     старую slf4j-api, приезжающую транзитивно через kafka-clients. -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Ядро Flink: DataStream API, основные классы для построения pipeline -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
        </dependency>

        <!-- Позволяет запускать Flink job локально (без отдельного кластера) —
             то, что нам и нужно для пет-проекта на этом этапе -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-clients</artifactId>
            <version>${flink.version}</version>
        </dependency>

        <!-- Коннектор для чтения из Kafka как источника данных -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>3.2.0-1.19</version>
        </dependency>

        <!-- Jackson-модуль для сериализации/десериализации Java-объектов в JSON
             внутри Flink pipeline (например, при парсинге сообщений из Kafka) -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-json</artifactId>
            <version>${flink.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <version>${flink.version}</version>
        </dependency>

        <!-- Flink JDBC connector — универсальный sink для любых JDBC-совместимых БД -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-jdbc</artifactId>
            <version>3.2.0-1.19</version>
        </dependency>

        <!-- Официальный JDBC-драйвер ClickHouse. Classifier "all" — берём jar
             со всеми зависимостями драйвера внутри (shaded/fat jar), чтобы не
             подбирать вручную его собственные транзитивные зависимости. -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>0.6.3</version>
            <classifier>all</classifier>
        </dependency>

    </dependencies>
</project>